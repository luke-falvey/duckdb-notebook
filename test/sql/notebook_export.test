# name: test/sql/notebook_export.test
# description: notebook_export writes HTML, Markdown, SQL and data files
# group: [sql]

require sketchbook

query II
SELECT format, bytes > 50000 FROM notebook_export('test/notebooks/basic.sql', file := '__TEST_DIR__/basic.html')
----
html	true

# One self-contained page: the viewer, the styles and the gzip-compressed results are inline
query III
SELECT content LIKE '<!doctype html>%', content LIKE '%id="nb-data">H4sI%', content NOT LIKE '%<script src=%' FROM read_text('__TEST_DIR__/basic.html')
----
true	true	true

statement ok
FROM notebook_export('test/notebooks/basic.sql', file := '__TEST_DIR__/basic.md', format := 'md')

query II
SELECT content LIKE '%# Basic%', content LIKE '%| grp | n |%' FROM read_text('__TEST_DIR__/basic.md')
----
true	true

statement ok
FROM notebook_export('test/notebooks/basic.sql', file := '__TEST_DIR__/basic.expanded.sql', format := 'sql')

query I
SELECT content = (SELECT sql FROM notebook_sql('test/notebooks/basic.sql')) FROM read_text('__TEST_DIR__/basic.expanded.sql')
----
true

# B10: options are checked before anything runs; params names as notebook_run checks them
statement error
FROM notebook_export('test/notebooks/basic.sql', format := 'docx')
----
Unknown export format 'docx'; expected html, html-wasm, md, sql, data or pdf

statement error
FROM notebook_export('test/notebooks/basic.sql', format := 'data', data_format := 'xlsx')
----
data_format must be 'parquet' or 'csv', not 'xlsx'

statement error
FROM notebook_export('test/notebooks/basic.sql', interactive := 'live')
----
interactive must be 'precomputed', not 'live'

statement error
FROM notebook_export('examples/revenue.sql', file := '{TEST_DIR}/p.html', params := {no_such_input: 1})
----
no_such_input

# B1: the sql export refuses what notebook_sql refuses, graph errors included
statement error
FROM notebook_export('test/notebooks/graph_errors.sql', file := '{TEST_DIR}/graph_errors.expanded.sql', format := 'sql')
----
'later' is defined further down, at line 5

# The expanded example in examples/ is notebook_sql's output, kept in step with the notebook
query I
SELECT content = (SELECT sql FROM notebook_sql('examples/revenue.sql')) FROM read_text('examples/revenue.expanded.sql')
----
true

# One file per named query cell
query II
SELECT format, note FROM notebook_export('test/notebooks/basic.sql', file := '__TEST_DIR__/basic_data', format := 'data', data_format := 'csv')
----
data	3 file(s)

query I
SELECT count(*) FROM read_csv('__TEST_DIR__/basic_data/kept.csv')
----
6

# Parameters apply as in notebook_run
statement ok
FROM notebook_export('test/notebooks/basic.sql', file := '__TEST_DIR__/basic8.md', format := 'md', params := {lowest: 8})

query I
SELECT content LIKE '%| 8 | 2 |%' FROM read_text('__TEST_DIR__/basic8.md')
----
true

# Precomputed inputs: the exporter reports what it did
query I
SELECT note FROM notebook_export('examples/revenue.sql', file := '__TEST_DIR__/revenue.html', interactive := 'precomputed')
----
3 precomputed state(s); frozen at their current value: min_amount

# hide := hides code or results in every cell, on top of each cell's own hide=
statement ok
FROM notebook_export('test/notebooks/basic.sql', file := '__TEST_DIR__/nocode.md', format := 'md', hide := 'code')

query III
SELECT content NOT LIKE '%```sql%', content LIKE '%| grp | n |%', content LIKE '%# Basic%' FROM read_text('__TEST_DIR__/nocode.md')
----
true	true	true

statement ok
FROM notebook_export('test/notebooks/basic.sql', file := '__TEST_DIR__/nooutput.md', format := 'md', hide := 'output')

query III
SELECT content LIKE '%```sql%', content NOT LIKE '%| grp | n |%', content LIKE '%# Basic%' FROM read_text('__TEST_DIR__/nooutput.md')
----
true	true	true

statement error
FROM notebook_export('test/notebooks/basic.sql', file := '__TEST_DIR__/x.md', format := 'md', hide := 'everything')
----
hide must be 'code', 'output', 'all' or 'none'

# The page carries its fonts, so it looks the same offline
query II
SELECT content LIKE '%url(data:font/woff2;base64,%', content NOT LIKE '%/assets/%' FROM read_text('__TEST_DIR__/basic.html')
----
true	true

statement error
FROM notebook_export('test/notebooks/basic.sql', format := 'docx')
----
Unknown export format 'docx'

statement error
FROM notebook_export('test/notebooks/basic.sql', file := '__TEST_DIR__/x.html', format := 'html-wasm', wasm_runtime := '__TEST_DIR__/nope')
----
not found. Build the runtime with wasm/build.sh

statement error
FROM notebook_export('test/notebooks/errors.sql', file := '__TEST_DIR__/x.html')
----
has errors

statement ok
DROP TABLE nb_test_numbers

statement ok
DROP TABLE orders

# Exports are the same on every run: grouped and sorted chart queries have a total order, and the example's
# data is exact (B32). This is probabilistic: three runs can agree by chance. The exact guard is the core
# test of the ORDER BY each query gets (TestChartErrors).
statement ok
FROM notebook_export('examples/charts.sql', file := '{TEST_DIR}/det1.md', format := 'md')

statement ok
FROM notebook_export('examples/charts.sql', file := '{TEST_DIR}/det2.md', format := 'md')

statement ok
FROM notebook_export('examples/charts.sql', file := '{TEST_DIR}/det3.md', format := 'md')

query I
SELECT count(DISTINCT content) FROM read_text('{TEST_DIR}/det*.md')
----
1

statement ok
DROP TABLE gallery_sales

statement ok
DROP TABLE gallery_tasks

# ---- Exports leave nothing attached ----

# What the [notebook] cell attaches is detached again, as notebook_run does
statement ok
FROM notebook_export('test/notebooks/attach_mode.sql', file := '__TEST_DIR__/attach_mode.html')

statement ok
FROM notebook_export('test/notebooks/attach_mode.sql', file := '__TEST_DIR__/attach_mode.md', format := 'md')

statement ok
FROM notebook_export('test/notebooks/attach_mode.sql', file := '__TEST_DIR__/attach_mode_data', format := 'data')

query I
SELECT count(*) FROM duckdb_databases() WHERE database_name = 'nb_meta_mode'
----
0

# html-wasm writes the data the notebook reads into a database of its own; one it cannot copy fails the export, which
# leaves that database neither attached nor on disk, and the next export works
statement ok
CREATE TABLE nb_wasm_src AS SELECT '1x' AS s

statement ok
CREATE VIEW nb_wasm_bad AS SELECT s::INTEGER AS x FROM nb_wasm_src

statement ok
COPY (SELECT '-- %% shown' || chr(10) || 'SELECT count(*) AS n FROM nb_wasm_src, nb_wasm_bad;' || chr(10)) TO '__TEST_DIR__/nb_wasm_bad.sql' (FORMAT csv, HEADER false, QUOTE '')

statement error
FROM notebook_export('__TEST_DIR__/nb_wasm_bad.sql', file := '__TEST_DIR__/x.html', format := 'html-wasm', wasm_runtime := '__TEST_DIR__/nope')
----
html-wasm export: Conversion Error

query I
SELECT count(*) FROM duckdb_databases() WHERE database_name LIKE '__notebook_export%'
----
0

statement error
FROM notebook_export('test/notebooks/basic.sql', file := '__TEST_DIR__/x.html', format := 'html-wasm', wasm_runtime := '__TEST_DIR__/nope')
----
not found. Build the runtime with wasm/build.sh

statement ok
DROP VIEW nb_wasm_bad

statement ok
DROP TABLE nb_wasm_src
