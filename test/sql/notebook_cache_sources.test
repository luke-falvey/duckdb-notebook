# name: test/sql/notebook_cache_sources.test
# description: The result cache sees changes to the files a cell reads, and calls what it cannot check unverified
# group: [sql]

require sketchbook

statement ok
COPY (SELECT range AS i FROM range(3)) TO '{TEST_DIR}/nb_src_data.csv' (HEADER)

statement ok
CREATE TABLE nb_src_table AS SELECT 1 AS n

# A cell reading the file by its path, a cell reading that cell, one reading a table no cell defines, and one
# reading nothing
statement ok
COPY (SELECT '-- %% src' || chr(10) || 'SELECT * FROM read_csv(''{TEST_DIR}/nb_src_data.csv'');' || chr(10) || chr(10) || '-- %% total' || chr(10) || 'SELECT count(*) AS n FROM src;' || chr(10) || chr(10) || '-- %% outside' || chr(10) || 'SELECT * FROM nb_src_table;' || chr(10) || chr(10) || '-- %% one' || chr(10) || 'SELECT 1 AS one;' || chr(10)) TO '{TEST_DIR}/nb_src.sql' (FORMAT csv, HEADER false, QUOTE '')

statement ok
FROM notebook_cache_clear('{TEST_DIR}/nb_src.sql')

# Modified times are whole seconds: a file written in the last two seconds could change again without its time
# changing, so what reads it is not called fresh yet
statement ok
FROM notebook_run('{TEST_DIR}/nb_src.sql', cache := true)

query II
SELECT cell, status FROM notebook_cache('{TEST_DIR}/nb_src.sql') ORDER BY idx
----
src	unverified
total	unverified
outside	unverified
one	fresh

sleep 2100 millisecond

query II
SELECT name, status FROM notebook_run('{TEST_DIR}/nb_src.sql', cache := true) ORDER BY idx
----
src	ok
total	ok
outside	ok
one	ok

query II
SELECT cell, status FROM notebook_cache('{TEST_DIR}/nb_src.sql') ORDER BY idx
----
src	fresh
total	fresh
outside	unverified
one	fresh

# The file is written again with other rows: what reads it, directly or not, is stale
statement ok
COPY (SELECT range AS i FROM range(5)) TO '{TEST_DIR}/nb_src_data.csv' (HEADER)

query II
SELECT cell, status FROM notebook_cache('{TEST_DIR}/nb_src.sql') ORDER BY idx
----
src	stale
total	stale
outside	unverified
one	fresh

# Running again records the new version
sleep 2100 millisecond

statement ok
FROM notebook_run('{TEST_DIR}/nb_src.sql', cache := true)

query II
SELECT cell, status FROM notebook_cache('{TEST_DIR}/nb_src.sql') ORDER BY idx
----
src	fresh
total	fresh
outside	unverified
one	fresh

# The versions are taken before the cells run: a file a later cell writes leaves what read it before stale
statement ok
COPY (SELECT '-- %% before' || chr(10) || 'SELECT count(*) AS n FROM read_csv(''{TEST_DIR}/nb_src_data.csv'');' || chr(10) || chr(10) || '-- %% rewrite' || chr(10) || 'COPY (SELECT range AS i FROM range(7)) TO ''{TEST_DIR}/nb_src_data.csv'' (HEADER);' || chr(10)) TO '{TEST_DIR}/nb_src_write.sql' (FORMAT csv, HEADER false, QUOTE '')

statement ok
FROM notebook_run('{TEST_DIR}/nb_src_write.sql', cache := true)

sleep 2100 millisecond

query II
SELECT cell, status FROM notebook_cache('{TEST_DIR}/nb_src_write.sql') WHERE cell = 'before'
----
before	stale

statement ok
FROM notebook_cache_clear('{TEST_DIR}/nb_src_write.sql')

# A cell is keyed with the files as it read them: one that reads what an earlier cell of the run wrote is not stale
# after the run (it is unverified, the file being too new to vouch for when it was read), and never becomes fresh
# by mistake: a later change to the file makes it stale
statement ok
COPY (SELECT '-- %% make' || chr(10) || 'COPY (SELECT range AS i FROM range(4)) TO ''{TEST_DIR}/nb_src_made.csv'' (HEADER);' || chr(10) || chr(10) || '-- %% made' || chr(10) || 'SELECT count(*) AS n FROM read_csv(''{TEST_DIR}/nb_src_made.csv'');' || chr(10)) TO '{TEST_DIR}/nb_src_made.sql' (FORMAT csv, HEADER false, QUOTE '')

statement ok
FROM notebook_run('{TEST_DIR}/nb_src_made.sql', cache := true)

sleep 2100 millisecond

query II
SELECT cell, status FROM notebook_cache('{TEST_DIR}/nb_src_made.sql') WHERE cell = 'made'
----
made	unverified

statement ok
FROM notebook_run('{TEST_DIR}/nb_src_made.sql', cache := true)

sleep 2100 millisecond

query II
SELECT cell, status FROM notebook_cache('{TEST_DIR}/nb_src_made.sql') WHERE cell = 'made'
----
made	unverified

statement ok
COPY (SELECT range AS i FROM range(9)) TO '{TEST_DIR}/nb_src_made.csv' (HEADER)

query II
SELECT cell, status FROM notebook_cache('{TEST_DIR}/nb_src_made.sql') WHERE cell = 'made'
----
made	stale

statement ok
FROM notebook_cache_clear('{TEST_DIR}/nb_src_made.sql')

# With file_search_path set, DuckDB may read a relative path from another directory than the one looked at: what
# reads one is unverified
statement ok
COPY (SELECT '-- %% rel' || chr(10) || 'SELECT count(*) AS n FROM read_csv(''nb_src_rel.csv'');' || chr(10)) TO '{TEST_DIR}/nb_src_rel.sql' (FORMAT csv, HEADER false, QUOTE '')

statement ok
COPY (SELECT 1 AS i) TO '{TEST_DIR}/nb_src_rel.csv' (HEADER)

statement ok
SET GLOBAL file_search_path = '{TEST_DIR}'

sleep 2100 millisecond

query II
SELECT name, status FROM notebook_run('{TEST_DIR}/nb_src_rel.sql', cache := true)
----
rel	ok

query II
SELECT cell, status FROM notebook_cache('{TEST_DIR}/nb_src_rel.sql')
----
rel	unverified

statement ok
RESET GLOBAL file_search_path

statement ok
FROM notebook_cache_clear('{TEST_DIR}/nb_src_rel.sql')

# The same when a cell of the notebook sets it (on the connection the cells run on, which opening never sees)
statement ok
COPY (SELECT '-- %%' || chr(10) || 'SET file_search_path = ''{TEST_DIR}'';' || chr(10) || chr(10) || '-- %% rel' || chr(10) || 'SELECT count(*) AS n FROM read_csv(''nb_src_rel.csv'');' || chr(10)) TO '{TEST_DIR}/nb_src_rel_set.sql' (FORMAT csv, HEADER false, QUOTE '')

query II
SELECT name, status FROM notebook_run('{TEST_DIR}/nb_src_rel_set.sql', cache := true) WHERE name = 'rel'
----
rel	ok

query II
SELECT cell, status FROM notebook_cache('{TEST_DIR}/nb_src_rel_set.sql') WHERE cell = 'rel'
----
rel	unverified

statement ok
FROM notebook_cache_clear('{TEST_DIR}/nb_src_rel_set.sql')

# A file read through a view is read when the cell selecting from the view runs: what reads the view after a cell
# rewrote the file is not stale (unverified: the file is too new to vouch for), while the view's own result is
statement ok
COPY (SELECT '-- %% v' || chr(10) || 'SELECT * FROM read_csv(''{TEST_DIR}/nb_src_view.csv'');' || chr(10) || chr(10) || '-- %% w' || chr(10) || 'COPY (SELECT range AS i FROM range(7)) TO ''{TEST_DIR}/nb_src_view.csv'' (HEADER);' || chr(10) || chr(10) || '-- %% r' || chr(10) || 'SELECT count(*) AS n FROM v;' || chr(10)) TO '{TEST_DIR}/nb_src_view.sql' (FORMAT csv, HEADER false, QUOTE '')

statement ok
COPY (SELECT 1 AS i) TO '{TEST_DIR}/nb_src_view.csv' (HEADER)

sleep 2100 millisecond

statement ok
FROM notebook_run('{TEST_DIR}/nb_src_view.sql', cache := true)

sleep 2100 millisecond

query II
SELECT cell, status FROM notebook_cache('{TEST_DIR}/nb_src_view.sql') WHERE cell IN ('v', 'r') ORDER BY idx
----
v	stale
r	unverified

statement ok
FROM notebook_cache_clear('{TEST_DIR}/nb_src_view.sql')

# Clean up: all test files share one database
query I
SELECT removed FROM notebook_cache_clear('{TEST_DIR}/nb_src.sql')
----
4

statement ok
DROP TABLE nb_src_table

# A table function the cache knows nothing of (a table macro here; an extension's reader such as st_read alike)
# makes what reads it unverified, never fresh
statement ok
CREATE TABLE nb_src_macro_rows AS SELECT 1 AS n

statement ok
CREATE MACRO nb_src_macro() AS TABLE FROM nb_src_macro_rows

statement ok
COPY (SELECT '-- %% via_macro' || chr(10) || 'SELECT * FROM nb_src_macro();' || chr(10) || chr(10) || '-- %% counted' || chr(10) || 'SELECT * FROM range(3);' || chr(10)) TO '{TEST_DIR}/nb_src_macro.sql' (FORMAT csv, HEADER false, QUOTE '')

statement ok
FROM notebook_run('{TEST_DIR}/nb_src_macro.sql', cache := true)

query II
SELECT cell, status FROM notebook_cache('{TEST_DIR}/nb_src_macro.sql') ORDER BY idx
----
via_macro	unverified
counted	fresh

statement ok
FROM notebook_cache_clear('{TEST_DIR}/nb_src_macro.sql')

statement ok
DROP MACRO TABLE nb_src_macro

statement ok
DROP TABLE nb_src_macro_rows
