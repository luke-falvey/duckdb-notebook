# name: test/sql/notebook_cells.test
# description: notebook_cells parses a notebook file into one row per cell
# group: [sql]

require sketchbook

query IIIIIII
SELECT idx, kind, name, widget, is_query, start_line, end_line FROM notebook_cells('test/notebooks/basic.sql') ORDER BY idx
----
0	notebook	NULL	NULL	NULL	2	7
1	markdown	NULL	NULL	NULL	8	13
2	sql	numbers	NULL	false	14	16
3	input	lowest	slider	NULL	17	19
4	sql	kept	NULL	true	20	23
5	sql	by_group	NULL	true	24	26
6	chart	NULL	NULL	NULL	27	34
7	sql	picked_rows	NULL	true	35	37
8	sql	NULL	NULL	true	38	39

# Options keep their file order; quoted values may contain spaces
query I
SELECT options FROM notebook_cells('test/notebooks/basic.sql') WHERE name = 'lowest'
----
{min=0, max=9, label=Lowest value}

query I
SELECT options['materialize'] FROM notebook_cells('test/notebooks/basic.sql') WHERE name = 'by_group'
----
table

# A marker-looking line inside a block comment is content
query I
SELECT replace(content, chr(10), ' / ') FROM notebook_cells('test/notebooks/basic.sql') WHERE kind = 'markdown'
----
# Basic / -- %% this line is inside a comment, so it is not a cell marker

# Variables read with $name
query II
SELECT name, variables FROM notebook_cells('test/notebooks/basic.sql') WHERE len(variables) > 0 ORDER BY idx
----
kept	[lowest]
picked_rows	[picked]

query I
SELECT count(*) FROM notebook_cells('test/notebooks/basic.sql') WHERE len(errors) > 0
----
0

# The dependency graph: what each cell defines and reads, and the cells it depends on
query IIII
SELECT idx, defines, reads, depends_on FROM notebook_cells('test/notebooks/basic.sql') ORDER BY idx
----
0	[]	[]	[]
1	[]	[]	[]
2	[nb_test_numbers]	[]	[]
3	[$lowest]	[]	[]
4	[kept]	[$lowest, nb_test_numbers]	[2, 3]
5	[by_group]	[kept]	[4]
6	[$picked]	[by_group]	[5]
7	[picked_rows]	[$picked, kept]	[4, 6]
8	[]	[picked_rows]	[7]

# Markdown {{ }} expressions are dependencies too, and may read cells further down
query III
SELECT reads, depends_on, variables FROM notebook_cells('examples/revenue.sql') WHERE kind = 'markdown'
----
[$region, monthly]	[4, 7]	[region]

# Graph errors: forward references, two cells defining one name, cycles through a chart
query II
SELECT coalesce(name, start_line::VARCHAR), errors FROM notebook_cells('test/notebooks/graph_errors.sql') ORDER BY idx
----
early	['\'later\' is defined further down, at line 5; SQL and input cells can only use cells above them']
later	[]
8	['\'nb_test_twice\' is defined by more than one cell (lines 8, 11)']
11	['\'nb_test_twice\' is defined by more than one cell (lines 8, 11)']
trend	['dependency cycle between trend, detail']
detail	['dependency cycle between trend, detail']
loose	[]

query II
SELECT name, warnings FROM notebook_cells('test/notebooks/graph_errors.sql') WHERE len(warnings) > 0
----
loose	['variable \'nobody_sets_this\' is not set by any cell, so it reads as NULL']

# hide=, rows= and screen= are checked; other options are free-form
query II
SELECT name, errors FROM notebook_cells('test/notebooks/options.sql') ORDER BY idx
----
shown	[]
secret	[]
bad_hide	['hide=everything is not valid; use hide=code, hide=output, hide=all or hide=none']
bad_rows	['rows=0 is not valid; rows is a page size from 1 to 10000']
joined	[]
bad_screen	['screen=next is not valid; use screen=new, screen=join or screen=skip']

# Format errors are data, one list per cell, so a UI can show them all
query II
SELECT idx, errors[1] FROM notebook_cells('test/notebooks/errors.sql') ORDER BY idx
----
0	duplicate cell name 'totals'
1	duplicate cell name 'totals'
2	invalid cell name 'Bad-Name'; names match [a-z_][a-z0-9_]*
3	markdown cell body must be a single /* ... */ block comment
4	input cell 'threshold' sets variable 'other_name'; the two names must match
5	chart cell needs from=<cell or table>
6	unterminated {{ in markdown; expressions are written {{ expr }}

# width: in the [notebook] cell is normal or wide (FORMAT §6); anything else is an error on that cell
query I
SELECT count(*) FILTER (len(errors) > 0) FROM notebook_cells('test/notebooks/metadata.sql')
----
0

query II
SELECT kind, errors[1] FROM notebook_cells('test/notebooks/bad_width.sql') WHERE len(errors) > 0
----
notebook	width: 1400px is not valid; use width: normal or width: wide

# The example notebook in the repository stays valid
query II
SELECT count(*), count(*) FILTER (len(errors) > 0) FROM notebook_cells('examples/revenue.sql')
----
11	0

statement error
SELECT * FROM notebook_cells('test/notebooks/missing.sql')
----
<REGEX>:.*Cannot open file.*missing\.sql.*
