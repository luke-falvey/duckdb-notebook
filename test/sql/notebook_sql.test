# name: test/sql/notebook_sql.test
# description: notebook_sql expands a notebook into a plain SQL script
# group: [sql]

require sketchbook

# Named query cells become temp views (or temp tables); display-only cells are dropped;
# variables that only a chart selection sets start as NULL
# (compared line by line, skipping blank lines, which the test format cannot hold)
query I
SELECT line FROM (SELECT unnest(string_split(sql, chr(10))) AS line FROM notebook_sql('test/notebooks/basic.sql')) WHERE line <> ''
----
-- Expanded from test/notebooks/basic.sql. Runs in any DuckDB 2.0+ client; no extension needed.
-- Generated by notebook_sql(); edit the notebook, not this file.
-- Variables read by cells but set only interactively start as NULL.
SET VARIABLE "picked" = NULL;
-- sql cell numbers (line 14)
CREATE OR REPLACE TABLE nb_test_numbers AS SELECT i, i % 3 AS grp FROM range(10) t(i);
-- input cell lowest (line 17)
SET VARIABLE lowest = 4;
-- sql cell kept (line 20)
-- rows at or above the input
CREATE OR REPLACE TEMP VIEW "kept" AS
SELECT * FROM nb_test_numbers WHERE i >= $lowest;
-- sql cell by_group (line 24)
CREATE OR REPLACE TEMP TABLE "by_group" AS
SELECT grp, count(*) AS n FROM kept GROUP BY grp ORDER BY grp;
-- sql cell picked_rows (line 35)
CREATE OR REPLACE TEMP VIEW "picked_rows" AS
SELECT * FROM kept WHERE $picked IS NULL OR list_contains($picked, grp);
-- sql cell (line 38)
SELECT count(*) FROM picked_rows;

# A notebook with format errors has no script
statement error
SELECT sql FROM notebook_sql('test/notebooks/errors.sql')
----
duplicate cell name 'totals'

statement error
SELECT sql FROM notebook_sql('test/notebooks/graph_errors.sql')
----
'later' is defined further down

# A cell that ends in a -- comment: the semicolon after it goes on a line of its own, or the comment would swallow it
# and the next cell's statement with it
statement ok
COPY (SELECT '-- %% daily materialize=table' || chr(10) || 'SELECT 1 AS x -- by day' || chr(10) || chr(10) || '-- %% next' || chr(10) || 'SELECT * FROM daily -- trailing' || chr(10)) TO '__TEST_DIR__/nb_trailing.sql' (FORMAT csv, HEADER false, QUOTE '')

query II
SELECT contains(sql, 'SELECT 1 AS x -- by day' || chr(10) || ';'), contains(sql, 'SELECT * FROM daily -- trailing' || chr(10) || ';') FROM notebook_sql('__TEST_DIR__/nb_trailing.sql')
----
true	true

query II
SELECT name, status FROM notebook_run('__TEST_DIR__/nb_trailing.sql') ORDER BY idx
----
daily	ok
next	ok
